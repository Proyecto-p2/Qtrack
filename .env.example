# Configuración de la base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=db_name

# Configuración adicional de la aplicación
NODE_ENV=development
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# Instrucciones:
# 1. Copia este archivo como .env
# 2. Reemplaza los valores de ejemplo con tus datos reales
# 3. Nunca subas el archivo .env a Git
# 4. Para generar NEXTAUTH_SECRET usa: openssl rand -base64 32
